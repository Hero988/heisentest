{
  "name": "heisentest",
  "private": true,
  "version": "0.1.0",
  "description": "Analyze huge log files in your browser tab. Nothing is uploaded.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
